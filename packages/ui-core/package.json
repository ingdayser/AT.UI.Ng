{
  "name": "@at/ui-core",
  "version": "0.1.0",
  "description": "Framework-agnostic building blocks shared by every Apoyos Tecnologicos front end: API envelope, session models, JWT helper, es-CO formatters and error messages.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/ApoyosTecnologicos/_packaging/ApoyosTecnologicos/npm/registry/",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ingdayser/AT.UI.Ng.git",
    "directory": "packages/ui-core"
  }
}
