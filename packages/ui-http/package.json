{
  "name": "@at/ui-http",
  "version": "0.1.0",
  "description": "HTTP building blocks for Angular apps of Apoyos Tecnologicos: BaseHttpService, loading counter and interceptors for loading and error notices.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@at/ui-core": "^0.1.0"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@ngrx/signals": "^22.0.0",
    "rxjs": "^7.8.0"
  },
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/ApoyosTecnologicos/_packaging/ApoyosTecnologicos/npm/registry/",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ingdayser/AT.UI.Ng.git",
    "directory": "packages/ui-http"
  }
}
